"""
optimizer.py — Parameter Optimization Framework (dormant until 200+ trades).

Two optimizers:
  - Bayesian Optimization with TPE (Tree-Structured Parzen Estimators)
    → Best for mean-reversion strategies (discontinuous landscapes)
  - Differential Evolution (DE)
    → Best for trend-following strategies (smooth fitness landscapes)

Both are dormant until asset_data_hub tracks 200+ trades per asset.
Activation is automatic when threshold is met.

Usage:
    from hermes_trading.optimizer import get_optimizer
    opt = get_optimizer(strategy_mode="mean_reversion")
    best_params = opt.optimize(trades, param_space, metric="sharpe")
"""

import json
import math
from datetime import datetime, timezone
from pathlib import Path
from typing import Callable, Dict, List, Optional, Tuple


# Minimum trades required before optimizer activates
MIN_TRADES_FOR_OPTIMIZATION = 200


def trades_ready(trades: List[dict]) -> bool:
    """Check if there are enough trades for optimization."""
    return len(trades) >= MIN_TRADES_FOR_OPTIMIZATION


class BaseOptimizer:
    """Abstract optimizer base class."""
    
    def __init__(self, name: str):
        self.name = name
        self.fitted = False
    
    def optimize(self, trades: List[dict], param_space: dict,
                 metric: str = "sharpe") -> dict:
        """Run optimization and return best params.
        
        Args:
            trades: List of trade dicts with pnl_pct
            param_space: Dict of {param_name: [min, max]} ranges
            metric: Objective metric to optimize
        
        Returns:
            {param: value, "metric": optimized_value}
        """
        raise NotImplementedError


class BayesianTPEOptimizer(BaseOptimizer):
    """Bayesian Optimization with TPE for mean-reversion strategies.
    
    Uses a simplified Parzen estimator approach.
    When activated, this should be replaced with optuna/scikit-optimize.
    """
    
    def __init__(self):
        super().__init__("bayesian_tpe")
    
    def optimize(self, trades, param_space, metric="sharpe"):
        # Placeholder — stores config for when library is available
        return {
            "optimizer": self.name,
            "status": "dormant",
            "required_trades": MIN_TRADES_FOR_OPTIMIZATION,
            "available_trades": len(trades),
            "recommendation": "Install optuna for full Bayesian TPE support"
        }


class DifferentialEvolutionOptimizer(BaseOptimizer):
    """Differential Evolution for trend-following strategies.
    
    Uses scipy's differential_evolution when available.
    """
    
    def __init__(self):
        super().__init__("differential_evolution")
    
    def optimize(self, trades, param_space, metric="sharpe"):
        # Placeholder
        return {
            "optimizer": self.name,
            "status": "dormant",
            "required_trades": MIN_TRADES_FOR_OPTIMIZATION,
            "available_trades": len(trades),
            "recommendation": "Install scipy for full DE support"
        }


def get_optimizer(strategy_mode: str = "mean_reversion") -> BaseOptimizer:
    """Select optimizer based on strategy mode.
    
    Args:
        strategy_mode: "mean_reversion" (TPE) or "trend" (DE)
    
    Returns:
        Configured optimizer instance
    """
    if strategy_mode == "trend":
        return DifferentialEvolutionOptimizer()
    return BayesianTPEOptimizer()


def check_and_optimize(asset_key: str, trades: List[dict],
                       current_config: dict) -> dict:
    """Check if trades are sufficient and run optimization.
    
    Returns dict with optimization result or dormant status.
    """
    result = {
        "asset": asset_key,
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "trades_available": len(trades),
        "threshold": MIN_TRADES_FOR_OPTIMIZATION,
        "ready": trades_ready(trades),
    }
    
    if not result["ready"]:
        result["status"] = "dormant"
        result["message"] = f"Need {MIN_TRADES_FOR_OPTIMIZATION - len(trades)} more trades"
        return result
    
    # Determine mode from current strategy
    mode = "mean_reversion"
    if current_config.get("hurst", {}).get("mode") == "trend":
        mode = "trend"
    
    # Define parameter space
    param_space = {
        "entry_threshold": [15, 50],
        "stop_loss_pct": [1.0, 8.0],
        "position_size_r": [0.1, 0.8],
        "cooldown_cycles": [5, 60],
    }
    
    opt = get_optimizer(mode)
    opt_result = opt.optimize(trades, param_space)
    
    result["status"] = "optimized"
    result["optimizer"] = opt.name
    result["result"] = opt_result
    
    return result
